rules_version = '2';

// Regole di sicurezza per Giulia Barani · Studio
// Sostituisci EMAIL_DI_GIULIA con l'email usata per il login (la stessa di js/config.js → adminEmail)
// e incolla tutto in Firebase Console → Firestore Database → Regole → Pubblica.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'giuliabarani71@gmail.com';
    }

    // Profili dei clienti: solo Giulia
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    // Temi dei progetti (Matrimonio, Coppia, …): solo Giulia
    match /themes/{themeId} {
      allow read, write: if isAdmin();
    }

    // Notifiche: il cliente può solo crearne una quando invia le scelte di un progetto aperto;
    // le legge e le segna come lette solo Giulia.
    match /notifications/{nid} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['type', 'projectId', 'projectTitle', 'clientName', 'count', 'read', 'at'])
        && request.resource.data.type == 'submitted'
        && request.resource.data.read == false
        && request.resource.data.projectId is string
        && request.resource.data.projectTitle is string && request.resource.data.projectTitle.size() <= 200
        && request.resource.data.clientName is string && request.resource.data.clientName.size() <= 200
        && request.resource.data.count is int
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
        && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.status == 'open';
    }

    match /projects/{projectId} {
      // Chi ha il link (ID casuale di 20 caratteri) può leggere il singolo progetto,
      // ma non può elencare tutti i progetti.
      allow get: if true;
      allow list, create, update, delete: if isAdmin();

      // Foto a bassa risoluzione e coppie di stile
      match /images/{imageId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Scelte del cliente
      match /response/{docId} {
        allow read: if true;
        allow write: if isAdmin();
        allow create, update: if docId == 'main'
          && get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'open'
          && (resource == null || resource.data.status != 'submitted')
          && request.resource.data.keys().hasOnly(['status', 'selected', 'comments', 'style', 'answers', 'updatedAt', 'submittedAt', 'viewedAt', 'lastViewAt'])
          && request.resource.data.status in ['draft', 'submitted']
          && request.resource.data.selected is list
          && request.resource.data.selected.size() <= 300;
      }
    }
  }
}
